# Copied to .env by `shopify app dev` (client id/secret/app url/scopes are injected automatically).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_files,write_files,read_locales,read_markets,read_discounts,write_discounts,read_themes

# SQLite for local/dev. For production point this at Postgres and switch
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.sqlite"

# Optional server-side defaults for integrations. Keys can also be pasted in the
# app's Settings screen (they are stored encrypted with SESSION_SECRET).
SESSION_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
DEEPL_API_KEY=
DEEPL_API_URL=https://api.deepl.com
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
